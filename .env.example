# Copy to .env.local (never commit real values)
NEXT_PUBLIC_SITE_URL=https://georgeportfoliowebsite.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=            # shown on the site and used as the fallback address
NEXT_PUBLIC_LINKEDIN_URL=             # your public LinkedIn profile URL
RESEND_API_KEY=                       # https://resend.com — enables the contact form
CONTACT_TO_EMAIL=                     # where form messages are delivered
CONTACT_FROM_EMAIL=                   # optional; must be a verified Resend sender
